rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function ownerEmail() {
      return "shazidsaharia21@gmail.com";
    }

    function userDoc() {
      return get(/databases/$(database)/documents/mess_users/$(request.auth.uid));
    }

    function isOwner() {
      return signedIn() && request.auth.token.email == ownerEmail();
    }

    function role() {
      return isOwner() ? "owner" : userDoc().data.role;
    }

    function blocked() {
      return !isOwner() && userDoc().data.blocked == true;
    }

    function canReadApp() {
      return signedIn() && !blocked();
    }

    function canWriteData() {
      return canReadApp() && (role() == "owner" || role() == "manager");
    }

    match /mess_users/{userId} {
      allow get: if signedIn() && (userId == request.auth.uid || canReadApp());
      allow list: if canReadApp();
      allow create: if signedIn() && userId == request.auth.uid;
      allow update, delete: if isOwner();
    }

    match /mess_members/{docId} {
      allow read: if canReadApp();
      allow create: if canWriteData() || (signedIn() && docId == request.auth.uid);
      allow update, delete: if canWriteData();
    }

    match /mess_payments/{docId} {
      allow read: if canReadApp();
      allow write: if canWriteData();
    }

    match /mess_expenses/{docId} {
      allow read: if canReadApp();
      allow write: if canWriteData();
    }

    match /mess_bazar/{docId} {
      allow read: if canReadApp();
      allow write: if canWriteData();
    }

    match /mess_meals/{docId} {
      allow read: if canReadApp();
      allow write: if canWriteData();
    }
  }
}
